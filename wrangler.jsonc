{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only for now. The consent-logging Worker and its D1 binding arrive in a later change.
  "name": "harrisonjennings-au",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Production is reached only through the www route (from cutover), never a public workers.dev copy.
  // Branch previews get workers.dev URLs, behind Cloudflare Access. See docs/deployment.md.
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for every non-production branch.
  // Empty: previews use the same assets and settings as production.
  "previews": {},
}
