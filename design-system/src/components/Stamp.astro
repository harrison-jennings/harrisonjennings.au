---
// The build stamp: when the design system was built and from which commit, linked on GitHub.
import { BUILD } from '../lib/build';
import Link from './Link.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={['ds-stamp', className]}>
  <i aria-hidden="true"></i>
  {BUILD.commit ? (
    <span>
      built {BUILD.date} from <Link href={BUILD.commitUrl}>{BUILD.commit}</Link>
    </span>
  ) : (
    <span>built {BUILD.date} from an uncommitted copy</span>
  )}
</p>
