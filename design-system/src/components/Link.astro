---
// A link, with the design system's rule for leaving it: another site opens in a new tab, with the
// hidden note for screen readers (lib/links.ts). Styling is the caller's.
import { NEW_TAB_NOTE, leavesSite, newTab } from '../lib/links';

interface Props {
  href: string;
  class?: string;
  [attr: string]: unknown;
}

const { href, class: className, ...rest } = Astro.props;
---

<a href={href} class={className} {...newTab(href)} {...rest}>
  <slot />
  {leavesSite(href) && <span class="visually-hidden">{NEW_TAB_NOTE}</span>}
</a>
