---
// One voice rule (design hand-off: PageFurniture, voice page): the rule as a heading with a line on
// why, beside its do/don't pair (the slot). The line is the `text` slot, so it can hold code.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="vo-rule">
  <div class="vo-rule__text">
    <h3>{title}</h3>
    <slot name="text" />
  </div>
  <div class="dd">
    <slot />
  </div>
</div>
