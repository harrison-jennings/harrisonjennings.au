---
// The design system's own pages. A plain placeholder until the shell is designed (see the mockup
// brief): the logo, a way back to the site, and the build stamp.
import '../../../src/styles/global.css';
import Logo from '../../../src/components/Logo.astro';
import TextLink from '../../../src/components/TextLink.astro';
import { BUILD } from '../lib/build';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title} · design system · harrison jennings</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      skip to content
    </a>
    <header class="shell ds-head">
      <a class="ds-brand" href="/">
        <Logo label="harrison jennings design system, home" />
        <span>design system</span>
      </a>
      <TextLink href="https://www.harrisonjennings.au/" quiet>
        harrisonjennings.au
      </TextLink>
    </header>
    <main id="main" class="column">
      <slot />
    </main>
    <footer class="column ds-foot">
      <p>
        built from{' '}
        {BUILD.commit ? (
          <TextLink href={BUILD.commitUrl} quiet>
            <code>{BUILD.commit}</code>
          </TextLink>
        ) : (
          'an uncommitted copy'
        )}
        , {BUILD.date}
      </p>
    </footer>
  </body>
</html>

<style>
  .ds-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    min-height: var(--target);
    padding-block: var(--space-22);
  }
  .ds-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-10);
    min-height: var(--target);
    color: var(--text);
    font-family: var(--font-display);
    text-decoration: none;
  }
  main {
    padding-block: var(--space-40) var(--space-72);
  }
  .ds-foot {
    padding-block: var(--space-28);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
</style>
