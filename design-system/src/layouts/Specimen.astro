---
// One example on its own, with the site's real styles and nothing else, so it renders exactly as it
// does on harrisonjennings.au. Preview frames show it in an iframe at a true screen width, in the theme
// they ask for (?theme=light), still when the reader prefers reduced motion (?still=1), and it reports
// its height back to them (specimen.ts).
import '../../../src/styles/global.css';
import '../../../src/styles/prose.css';

interface Props {
  title: string;
  /** Small examples (buttons, tags) sit in a centred, wrapping row; others take the width as a page would. */
  row?: boolean;
  /** At least a phone screen tall, for examples whose content sits over the page (an open menu). */
  screen?: boolean;
  /**
   * How a page-level example sits: `full` edge to edge (the hero, an open menu); `page` with room above
   * and below, its own gutters (it brings .column or .shell) and none of the space it keeps on a page
   * for what's above it (a section's margin, the room left for the floating nav).
   */
  layout?: 'full' | 'page' | undefined;
}

const { title, row = false, screen = false, layout } = Astro.props;
---

<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}: specimen</title>
    <script is:inline>
      const params = new URLSearchParams(location.search);
      document.documentElement.dataset.theme = params.get('theme') === 'light' ? 'light' : 'dark';
      if (params.get('still') === '1') document.documentElement.dataset.still = '';
    </script>
  </head>
  <body class:list={['specimen', layout && `specimen--${layout}`, { 'specimen--screen': screen }]}>
    {row ? (
      <div class="specimen__row">
        <slot />
      </div>
    ) : (
      <slot />
    )}
    <script>
      import '../scripts/specimen';
    </script>
  </body>
</html>

<style is:global>
  /* flow-root keeps a child's margins inside the body, so the height it reports includes them. */
  .specimen {
    display: flow-root;
    padding: var(--space-28) var(--space-22);
  }
  .specimen--full {
    padding: 0;
  }
  .specimen--page {
    padding: var(--space-28) 0;
  }
  body.specimen--page > :first-child,
  body.specimen--page > div.column:first-child > :first-child {
    margin-top: 0;
  }
  /* Room kept for the nav that isn't there: its own offset from the top, and the post header's space for it. */
  body.specimen--page > :first-child,
  body.specimen--page > div.column:first-child > .posthead {
    padding-top: 0;
  }
  .specimen--screen {
    min-height: 844px;
  }
  .specimen__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-16);
  }
  /* Still, for readers who prefer reduced motion: nothing animates or eases. */
  [data-still] *,
  [data-still] *::before,
  [data-still] *::after {
    animation: none !important;
    transition: none !important;
  }
</style>
