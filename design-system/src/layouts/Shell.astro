---
// The frame around every design system page (design hand-off: Shell and Sidebar): the brick line and
// "design system" beside the logo, the six sections, the section's sidebar, "on this page", the footer
// with the build stamp, and on phones the page picker and full-screen menu. Built from the pages that
// exist (lib/nav.ts). Landing pages (the overview) have no sidebar and no "on this page".
import '../../../src/styles/global.css';
import '../../../src/styles/prose.css';
import '../styles/shell.css';
import '../styles/furniture.css';
import Icon from '../../../src/components/Icon.astro';
import Logo from '../../../src/components/Logo.astro';
import ThemeHead from '../../../src/components/ThemeHead.astro';
import ThemeToggle from '../../../src/components/ThemeToggle.astro';
import DsIcon from '../components/DsIcon.astro';
import Link from '../components/Link.astro';
import SideGroups from '../components/SideGroups.astro';
import Stamp from '../components/Stamp.astro';
import { getNav } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  /** The section the page is in (overview for the landing page). */
  section: string;
  /** The current page's id (components/button), and its name for the phone's page picker. */
  page?: string | undefined;
  pageTitle?: string | undefined;
  /** The page's headings: its ## sections become "on this page". */
  headings?: { depth: number; slug: string; text: string }[];
  landing?: boolean;
}

const {
  title,
  description,
  section,
  page,
  pageTitle,
  headings = [],
  landing = false,
} = Astro.props;
const nav = await getNav();
const current = nav.find((s) => s.id === section);
const side = !landing && current && current.groups.length > 0 ? current : undefined;
const toc = landing ? [] : headings.filter((h) => h.depth === 2);
const SITE = 'https://www.harrisonjennings.au/';
const REPO = 'https://github.com/harrison-jennings/harrisonjennings.au';
---

<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title} · design system · harrison jennings</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeHead />
    <!-- Lets the sidebar and menu start with groups closed; without JavaScript, everything shows. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="ds">
    <a class="skip-link" href="#main">
      skip to content
    </a>
    <header class="ds-head">
      <a class="ds-lockup" href="/">
        <Logo size={24} label="harrison jennings design system, overview" />
        <span class="ds-lockup__name" aria-hidden="true">
          harrison jennings
        </span>
        <span class="ds-lockup__div" aria-hidden="true"></span>
        <span class="ds-lockup__ds" aria-hidden="true">
          design system
        </span>
      </a>
      <nav class="ds-sections" aria-label="Sections">
        {nav.map((s) => (
          <a href={s.href} aria-current={s.id === section ? 'true' : undefined}>
            {s.name}
          </a>
        ))}
      </nav>
      <div class="ds-head__end">
        {/* The search slot: a button goes here once search exists (docs/design-system.md). */}
        <ThemeToggle />
        <Link class="ds-back" href={SITE}>
          harrisonjennings.au
          <DsIcon name="arrow-out" size={14} />
        </Link>
        <button
          class="ds-iconbtn ds-iconbtn--outline ds-head__menu"
          type="button"
          aria-label="Menu"
          aria-haspopup="dialog"
          aria-controls="ds-menu"
          data-menu-open
        >
          <Icon name="menu" />
        </button>
      </div>
    </header>
    {!landing && pageTitle && current && (
      <div class="ds-where">
        <button type="button" aria-haspopup="dialog" aria-controls="ds-menu" data-menu-open>
          <span>{current.name} /</span>
          <b>{pageTitle}</b>
          <DsIcon name="chevron-down" />
        </button>
      </div>
    )}
    <div
      class:list={[
        'ds-body',
        { 'ds-body--landing': landing, 'ds-body--no-side': !side, 'ds-body--no-toc': !toc.length },
      ]}
    >
      {side && (
        <nav class="ds-side" aria-label={`${side.name} pages`}>
          <SideGroups section={side} current={page} place="side" />
        </nav>
      )}
      <main id="main" class="ds-main">
        <slot />
      </main>
      {toc.length > 0 && (
        <aside class="ds-toc" aria-label="On this page" data-toc>
          <p aria-hidden="true">on this page</p>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>
    <footer class="ds-foot">
      <a class="ds-foot__mark" href="/">
        <Logo size={24} label="harrison jennings design system, overview" />
        <span aria-hidden="true">design system</span>
      </a>
      <Stamp />
      <nav aria-label="Elsewhere">
        <Link href={SITE}>harrisonjennings.au</Link>
        <Link href={REPO}>GitHub</Link>
        <Link href={`${REPO}/blob/main/design/tokens.json`}>tokens.json</Link>
      </nav>
    </footer>

    <dialog class="ds-menu" id="ds-menu" aria-label="Menu" tabindex="-1" data-menu>
      <div class="ds-menu__top">
        <a class="ds-lockup" href="/">
          <Logo size={24} label="harrison jennings design system, overview" />
          <span class="ds-lockup__ds" aria-hidden="true">
            design system
          </span>
        </a>
        <button
          class="ds-iconbtn ds-iconbtn--outline"
          type="button"
          aria-label="Close menu"
          data-menu-close
        >
          <Icon name="close" />
        </button>
      </div>
      <div class="ds-menu__body">
        {/* The search field goes here once search exists. */}
        {nav.map((s) => (
          <div class="ds-menu__sec">
            <button
              type="button"
              aria-expanded={s.id === section ? 'true' : 'false'}
              aria-controls={`menu-${s.id}`}
              aria-current={s.id === section ? 'true' : undefined}
              data-section-toggle
            >
              {s.name}
              <DsIcon name="chevron-down" size={20} />
            </button>
            <div
              class="ds-menu__groups"
              id={`menu-${s.id}`}
              data-open={s.id === section ? 'true' : 'false'}
            >
              {s.id === 'overview' && (
                <ul class="ds-group__pages">
                  <li>
                    <a
                      href="/"
                      aria-current={landing && section === 'overview' ? 'page' : undefined}
                    >
                      overview
                    </a>
                  </li>
                </ul>
              )}
              <SideGroups section={s} current={page} place="menu" />
            </div>
          </div>
        ))}
      </div>
      <div class="ds-menu__end">
        <Link class="ds-back" href={SITE}>
          harrisonjennings.au
          <DsIcon name="arrow-out" size={14} />
        </Link>
        <Stamp />
      </div>
    </dialog>

    <script>
      import '../scripts/shell';
      import { bindCopyCode } from '../../../src/scripts/copy-code';
      import { bindToc } from '../../../src/scripts/toc';
      document.querySelectorAll<HTMLElement>('[data-toc]').forEach(bindToc);
      // A code snippet in a page is the site's own code block, with its copy button.
      document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach(bindCopyCode);
    </script>
  </body>
</html>
