---
// The overview: a landing page with no sidebar. A placeholder until its own page is built (step 4 of
// the build brief): what the design system is, and the pages so far.
import Shell from '../layouts/Shell.astro';
import { getNav } from '../lib/nav';

const nav = await getNav();
const sections = nav.filter((s) => s.id !== 'overview');
---

<Shell
  title="overview"
  description="The design system for harrisonjennings.au: brand, components, tokens and content, from the site's own code."
  section="overview"
  landing
>
  <h1 class="ds-title">
    design system<span class="stop" aria-hidden="true"></span>
  </h1>
  <p class="ds-lead">
    The brand, every component, every token and every kind of content a post can hold, built from
    the site's own code.
  </p>
  <div class="ds-doc">
    {sections.map((s) => (
      <>
        <h2>{s.name}</h2>
        <ul>
          {s.groups.flatMap((g) =>
            g.pages.map((p) => (
              <li>
                <a href={p.href}>{p.title}</a>
              </li>
            )),
          )}
        </ul>
      </>
    ))}
  </div>
</Shell>
