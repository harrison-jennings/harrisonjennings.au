{
  "name": "harrisonjennings.au",
  "version": "0.1.0",
  "private": true,
  "description": "Source for harrisonjennings.au: an Astro site deployed on Cloudflare Workers.",
  "type": "module",
  "license": "MIT",
  "author": "Harrison Jennings (https://www.harrisonjennings.au)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrison-jennings/harrisonjennings.au.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "npm run tokens",
    "dev": "astro dev",
    "prebuild": "npm run tokens",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "check": "npm run tokens && astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "INCLUDE_DRAFTS=true npm run build && npm run db:local && playwright test",
    "db:local": "wrangler d1 migrations apply CONSENT_DB --local",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run test:e2e",
    "lighthouse": "npm run build && npx --yes @lhci/cli@0.15.1 autorun",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "remark-directive": "^4.0.0",
    "satori": "0.33.5",
    "sharp": "^0.35.5",
    "unist-util-visit": "^5.1.0",
    "vanilla-cookieconsent": "3.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "hast-util-from-html": "^2.0.3",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-to-hast": "^13.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unified": "^11.0.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
