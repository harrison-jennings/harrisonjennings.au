---
// Floating pill navigation. Compacts after scrolling and opens back up on hover or focus.
// Under 760px it shows the mark and a menu button that opens the full-screen menu.
import { BOOKING_URL, NAV, SOCIAL, SITE } from '../consts';
import Button from './Button.astro';
import Icon from './Icon.astro';
import IconButton from './IconButton.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="nav-wrap">
  <nav class="nav" aria-label="Main" data-nav>
    <a class="nav__brand" href="/" data-logo-draw>
      <Logo size={26} draw />
      <span class="nav__name">{SITE.name}</span>
    </a>
    <div class="nav__links">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </div>
    <div class="nav__icons">
      <IconButton href={SOCIAL.github.href} label={SOCIAL.github.label} icon="github" />
      <IconButton href={SOCIAL.linkedin.href} label={SOCIAL.linkedin.label} icon="linkedin" />
    </div>
    <Button href={BOOKING_URL} label="book a call" size="s" class="nav__cta" external />
    <button
      class="nav__menu"
      type="button"
      aria-label="Open menu"
      aria-haspopup="dialog"
      data-menu-open
    >
      <Icon name="menu" />
    </button>
  </nav>

  <dialog class="menu" aria-label="Menu" data-menu>
    <div class="menu__inner">
      <div class="menu__top">
        <Logo size={30} />
        <button class="menu__close" type="button" aria-label="Close menu" data-menu-close>
          <Icon name="close" />
        </button>
      </div>
      <div class="menu__links">
        {NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </div>
      <Button href={BOOKING_URL} label="book a call" size="block" external />
      <div class="menu__social">
        <IconButton href={SOCIAL.github.href} label={SOCIAL.github.label} icon="github" outline />
        <IconButton
          href={SOCIAL.linkedin.href}
          label={SOCIAL.linkedin.label}
          icon="linkedin"
          outline
        />
      </div>
    </div>
  </dialog>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: var(--space-16);
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: var(--space-16);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-28);
    width: 100%;
    max-width: 1152px;
    background: var(--ground);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: var(--space-10) var(--space-10) var(--space-10) var(--space-22);
    transition:
      max-width 240ms ease,
      gap 240ms ease,
      padding 240ms ease;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links {
    display: flex;
    gap: 26px;
    margin-left: auto;
    font-size: 15px;
  }
  .nav__links a,
  .menu__links a {
    color: var(--text);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .nav__links a:hover,
  .menu__links a:hover {
    color: var(--link);
  }
  .nav__links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .nav__icons {
    display: flex;
    gap: 2px;
    padding-left: 12px;
    border-left: 1px solid var(--line);
  }
  .nav__menu,
  .menu__close {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--target);
    height: var(--target);
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .menu__close {
    display: inline-flex;
    margin-left: 0;
  }

  /* compact: after scrolling */
  .nav.is-compact {
    max-width: 560px;
    gap: 22px;
    padding: var(--space-8) var(--space-8) var(--space-8) var(--space-16);
  }
  .nav.is-compact .nav__name,
  .nav.is-compact .nav__icons {
    display: none;
  }
  .nav.is-compact .nav__links {
    gap: var(--space-20);
    font-size: 14px;
  }
  .nav.is-compact :global(.nav__cta) {
    --btn-px: 16px;
    padding-block: 10px;
    font-size: 14px;
  }
  .nav.is-compact :global(.mark) {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 760px) {
    .nav,
    .nav.is-compact {
      max-width: none;
      gap: 12px;
      padding: var(--space-8) var(--space-8) var(--space-8) var(--space-16);
    }
    .nav__links,
    .nav__icons,
    .nav :global(.nav__cta) {
      display: none;
    }
    .nav__menu {
      display: inline-flex;
    }
  }

  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ground);
    color: var(--text);
  }
  .menu::backdrop {
    background: var(--ground);
  }
  .menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-22);
    min-height: 100%;
    padding: 18px var(--space-16) 28px;
  }
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-14);
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.05em;
  }
  .menu__social {
    display: flex;
    gap: var(--space-10);
    margin-top: auto;
  }
</style>

<script>
  import { bindNav } from '../scripts/nav';
  document.querySelectorAll<HTMLElement>('[data-nav]').forEach(bindNav);

  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  opener?.addEventListener('click', () => menu?.showModal());
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => menu?.close());
  menu?.addEventListener('close', () => opener?.focus());
  window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => {
    if (e.matches && menu?.open) menu.close();
  });
</script>
