---
// Floating pill navigation and the full-screen phone menu. Compacts after 80px of scroll and opens
// back up on hover or focus. On the home page it floats over the hero; elsewhere it sits 16px from
// the top. Either way it stays in view while scrolling, so the compact state is seen.
import { BOOKING_URL, NAV, SOCIAL, SITE } from '../consts';
import Button from './Button.astro';
import Icon from './Icon.astro';
import IconButton from './IconButton.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Float over the page (the home hero) instead of taking space above it. */
  home?: boolean;
}

const { home = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class:list={['nav-wrap', 'shell', { 'nav-wrap--home': home }]}>
  <nav class="nav" aria-label="Main" data-nav>
    <a class="nav__brand" href="/" data-logo-draw>
      <Logo size={26} draw />
      <span class="nav__name">{SITE.name}</span>
    </a>
    <div class="nav__links">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </div>
    <ThemeToggle />
    <div class="nav__icons">
      <IconButton href={SOCIAL.github.href} label={SOCIAL.github.label} icon="github" />
      <IconButton href={SOCIAL.linkedin.href} label={SOCIAL.linkedin.label} icon="linkedin" />
    </div>
    <Button href={BOOKING_URL} label="book a call" size="s" class="nav__cta" external />
    <button
      class="control nav__menu"
      type="button"
      aria-label="Open menu"
      aria-haspopup="dialog"
      data-menu-open
    >
      <Icon name="menu" />
    </button>
  </nav>

  <dialog class="menu" aria-label="Menu" data-menu>
    <div class="menu__inner">
      <div class="menu__top">
        <a class="menu__brand" href="/">
          <Logo size={26} />
          {SITE.name}
        </a>
        <button class="control" type="button" aria-label="Close menu" data-menu-close>
          <Icon name="close" />
        </button>
      </div>
      <div class="menu__links">
        {NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </div>
      <div class="menu__cta">
        <Button href={BOOKING_URL} label="book a call" size="block" external />
      </div>
      <div class="menu__social">
        <IconButton href={SOCIAL.github.href} label={SOCIAL.github.label} icon="github" large />
        <IconButton
          href={SOCIAL.linkedin.href}
          label={SOCIAL.linkedin.label}
          icon="linkedin"
          large
        />
      </div>
    </div>
  </dialog>
</header>

<style>
  /* In the page flow 16px from the top, and stuck there while scrolling. The wrapper keeps the
     expanded height so compacting never shifts the page. */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    min-height: calc(var(--space-16) + var(--target) + 2 * var(--space-10) + 2px);
    padding-top: var(--space-16);
    pointer-events: none;
  }
  /* Home: floats over the hero. */
  .nav-wrap--home {
    position: fixed;
    inset: 0 0 auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-28);
    width: 100%;
    max-width: var(--container);
    height: max-content;
    background: var(--ground);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: var(--space-10) var(--space-10) var(--space-10) var(--space-22);
    pointer-events: auto;
    interpolate-size: allow-keywords;
    transition:
      max-width 240ms ease,
      gap 240ms ease,
      padding 240ms ease;
  }
  .nav__brand,
  .menu__brand {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links {
    display: flex;
    gap: 26px;
    margin-left: auto;
    font-size: 15px;
  }
  .nav__links a {
    position: relative;
    padding: 6px 0;
    color: var(--text);
    text-decoration: none;
  }
  /* A 1.5px brick underline grows in from the left on hover or focus; the current page keeps it. */
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 240ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .nav__links a:hover::after,
  .nav__links a:focus-visible::after,
  .nav__links a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav__icons {
    display: flex;
    gap: 2px;
    padding-left: 12px;
    border-left: 1px solid var(--line);
  }

  /* Outlined icon controls: the menu and close buttons. */
  .control {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--target);
    height: var(--target);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: color 150ms ease;
  }
  .control:hover {
    color: var(--link);
  }
  .nav__menu {
    display: none;
  }

  /* Compact, after 80px of scroll (desktop only): the name and icons drop away. */
  @media (min-width: 761px) {
    .nav.is-compact {
      max-width: max-content;
      gap: 22px;
      padding: var(--space-8) var(--space-8) var(--space-8) var(--space-16);
    }
    .nav.is-compact .nav__name,
    .nav.is-compact .nav__icons {
      display: none;
    }
    .nav.is-compact .nav__links {
      gap: var(--space-20);
      margin-left: 0;
      font-size: 14px;
    }
    .nav.is-compact :global(.nav__cta) {
      --btn-px: 16px;
      padding-block: 10px;
      font-size: 14px;
    }
    .nav.is-compact :global(.mark) {
      width: 24px;
      height: 24px;
    }
  }

  @media (max-width: 760px) {
    .nav {
      gap: 12px;
    }
    .nav__links,
    .nav__icons,
    .nav :global(.nav__cta) {
      display: none;
    }
    .nav__name {
      font-size: 15px;
    }
    .nav :global(.theme) {
      margin-left: auto;
    }
    .nav__menu {
      display: inline-flex;
    }
  }

  /* The phone menu: fills the screen; its top row sits exactly where the bar's was, so the close
     button lands under the thumb that pressed the menu button. */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ground);
    color: var(--text);
    pointer-events: auto;
  }
  .menu::backdrop {
    background: var(--ground);
  }
  .menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
    min-height: 100%;
    padding: var(--space-16) var(--space-16) var(--space-28);
  }
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 11px 11px 23px;
  }
  .menu__brand {
    font-size: 15px;
  }
  .menu__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-14);
    padding: 12px 23px 0;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.05em;
  }
  .menu__links a {
    color: var(--text);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .menu__links a:hover {
    color: var(--link);
  }
  .menu__links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .menu__cta {
    padding: 0 7px;
  }
  .menu__social {
    display: flex;
    gap: 4px;
    margin-top: auto;
    padding-left: 10px;
  }
</style>

<script>
  import { bindNav } from '../scripts/nav';
  document.querySelectorAll<HTMLElement>('[data-nav]').forEach((nav) => bindNav(nav));

  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  opener?.addEventListener('click', () => {
    menu?.showModal();
    menu?.querySelector<HTMLAnchorElement>('.menu__links a')?.focus();
  });
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  // Any link closes the menu (an in-page link wouldn't navigate away).
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
  menu?.addEventListener('close', () => opener?.focus());
  window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => {
    if (e.matches && menu?.open) menu.close();
  });
</script>
