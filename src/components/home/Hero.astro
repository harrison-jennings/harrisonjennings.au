---
// The home page's first screen: the headline over the signal field and ember clouds, the two-line
// subtitle, "read the blog" and "book a call", and a scroll cue that fades over the first 160px.
// The nav floats over it (Base's `home`).
import { getEntry } from 'astro:content';
import { BOOKING_URL } from '../../consts';
import Button from '../Button.astro';
import TextLink from '../TextLink.astro';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home.yaml: missing the `home` entry');
const { headline, lead, intro } = home.data;
const last = headline.length - 1;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__clouds" aria-hidden="true"></div>
  <canvas class="hero__field" aria-hidden="true" data-hero-field></canvas>
  <div class="hero__body column">
    <h1 id="hero-title" class="hero__title">
      {headline.map((line, i) => (
        <>
          {line}
          {i < last ? (
            <>
              {' '}
              <br />
            </>
          ) : (
            <span class="hero__stop" aria-hidden="true" data-hero-stop />
          )}
        </>
      ))}
    </h1>
    <div class="hero__row">
      <p class="hero__sub">
        <span class="hero__lead">{lead}</span>
        <br />
        {intro}
      </p>
      <div class="hero__actions">
        <TextLink href="/blog/">read the blog</TextLink>
        <Button href={BOOKING_URL} label="book a call" size="l" external />
      </div>
    </div>
  </div>
  <div class="hero__cue">
    <div class="column">
      <span class="cue" aria-hidden="true" data-cue>
        <svg width="14" height="14" viewBox="0 0 24 24">
          <path d="M5 9l7 7 7-7"></path>
        </svg>
        scroll
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: clamp(640px, 100svh, 1080px);
    background: var(--ground);
  }
  .hero__clouds {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.7;
    pointer-events: none;
    background:
      radial-gradient(60% 80% at 82% 18%, var(--cloud-brick), transparent 70%),
      radial-gradient(50% 70% at 98% 92%, var(--cloud-apricot), transparent 70%);
  }
  .hero__field {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 36px;
    padding-top: 168px;
    padding-bottom: 84px;
    pointer-events: none;
  }
  .hero__body :global(a),
  .hero__body :global(button) {
    pointer-events: auto;
  }
  /* The -0.045em nudge lines the display type up optically under the logo. */
  .hero__title {
    margin: 0 0 0 -0.045em;
    font-family: var(--font-display);
    font-size: clamp(40px, 6.6vw, 96px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.05em;
  }
  .hero__stop {
    display: inline-block;
    width: 0.19em;
    height: 0.19em;
    margin-left: 0.3em;
    border-radius: var(--radius-pill);
    background: var(--accent);
    vertical-align: baseline;
  }
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
  }
  .hero__sub {
    margin: 0;
    max-width: 600px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }
  .hero__lead {
    color: var(--text);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
  }
  .hero__cue {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
  }
  /* no line box under the cue, so it sits exactly 24px up */
  .hero__cue .column {
    display: flex;
  }
  .cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--muted);
    pointer-events: none;
    transition: opacity 200ms ease;
  }
  .cue svg {
    display: block;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    50%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: clamp(560px, 100svh, 1080px);
    }
    .hero__body {
      gap: 24px;
      padding-top: 112px;
      padding-bottom: 52px;
    }
    .hero__title {
      font-size: 44px;
    }
    .hero__sub {
      font-size: 17px;
    }
    .hero__row {
      gap: 24px;
    }
    .hero__actions {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 18px;
      width: 100%;
    }
    .hero__actions :global(.btn) {
      width: 100%;
    }
    .hero__actions :global(.link) {
      align-self: center;
    }
    .hero__cue {
      bottom: 18px;
    }
  }
</style>

<script>
  import { bindCue, bindField } from '../../scripts/field';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-field]');
  if (hero && canvas) bindField(hero, canvas);
  document.querySelectorAll<HTMLElement>('[data-cue]').forEach(bindCue);
</script>
