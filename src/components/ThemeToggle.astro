---
// Sun/moon button: shows the current theme (moon in dark, sun in light); its label says the action.
---

<button class="theme" type="button" aria-label="Switch to light mode" data-theme-toggle>
  <svg class="theme__sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
  </svg>
  <svg class="theme__moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
  </svg>
</button>

<style>
  .theme {
    position: relative;
    display: inline-flex;
    flex: none;
    width: var(--target);
    height: var(--target);
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: color 150ms ease;
  }
  .theme:hover {
    color: var(--link);
  }
  .theme svg {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: -10px 0 0 -10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 200ms ease,
      transform 320ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .theme__sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  .theme__moon {
    opacity: 1;
    transform: none;
  }
  :global([data-theme='light']) .theme__sun {
    opacity: 1;
    transform: none;
  }
  :global([data-theme='light']) .theme__moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
</style>

<script>
  import { bindThemeToggle } from '../scripts/theme';
  document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach(bindThemeToggle);
</script>
