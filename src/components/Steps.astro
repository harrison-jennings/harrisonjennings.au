---
// Numbered steps in a row of three (one column on phones), each under a hairline: 01, a title and a
// line. The RSS page's "how it works" and the design system's "how to use it".
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="steps">
  {steps.map((step, i) => (
    <li>
      <span class="steps__n" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3>{step.title}</h3>
      <p>{step.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-40);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    border-top: 1px solid var(--line);
    padding-top: var(--space-22);
  }
  .steps__n {
    display: block;
    margin-bottom: var(--space-10);
    font-family: var(--font-display);
    font-size: 12px;
    color: var(--link);
  }
  .steps h3 {
    margin: 0 0 var(--space-8);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .steps p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
