---
// Posts grouped by year: the year on the left (sticky), each post as a row (PostRow) of date, title,
// description and topics. Phones: one column, the date gains its year, and each year gets one
// line above it and none below.
import type { CollectionEntry } from 'astro:content';
import { byYear } from '../../lib/blog';
import PostRow from './PostRow.astro';

interface Props {
  posts: Array<CollectionEntry<'posts'>>;
  topicPages: ReadonlySet<string>;
}

const { posts, topicPages } = Astro.props;
---

<div class="archive">
  {byYear(posts).map(({ year, posts: list }) => (
    <section class="year" aria-labelledby={`year-${year}`}>
      <h2 class="year__label" id={`year-${year}`}>
        <span>{year}</span>
      </h2>
      <div>
        {list.map((post) => (
          <PostRow post={post} topicPages={topicPages} />
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .archive {
    margin-top: 64px;
  }
  .year {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 0 var(--space-32);
  }
  .year__label {
    margin: 0;
    padding-top: var(--space-28);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .year__label span {
    position: sticky;
    top: 24px;
  }
  .year + .year .year__label {
    border-top: 1px solid var(--line);
  }
  .year:last-child :global(.row:last-child) {
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .archive {
      margin-top: var(--space-40);
    }
    .year {
      grid-template-columns: minmax(0, 1fr);
    }
    .year__label {
      padding: var(--space-20) 0 2px;
      border-top: 1px solid var(--line);
    }
    .year :global(.row:first-child) {
      border-top: 0;
      padding-top: 14px;
    }
    .year:last-child :global(.row:last-child) {
      border-bottom: 0;
    }
  }
</style>
