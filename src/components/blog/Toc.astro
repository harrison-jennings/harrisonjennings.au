---
// "on this page": the post's h2s and, indented, its h3s. Desktop: beside the text, staying in view
// and marking the section being read. Phones: a closed panel above the text.
import type { MarkdownHeading } from 'astro';

interface Props {
  /** The post's headings: tocHeadings() in src/lib/blog.ts picks the h2s and h3s. */
  headings: MarkdownHeading[];
  /** The phone panel (above the text) instead of the desktop column. */
  phone?: boolean;
}

const { headings, phone = false } = Astro.props;
const items: Array<{ heading: MarkdownHeading; subs: MarkdownHeading[] }> = [];
for (const h of headings) {
  if (h.depth === 2 || !items.length) items.push({ heading: h, subs: [] });
  else items.at(-1)?.subs.push(h);
}
---

{phone ? (
  <details class="toc-phone">
    <summary>
      on this page
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M6 9l6 6 6-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </summary>
    <ol>
      {items.map(({ heading, subs }) => (
        <li>
          <a href={`#${heading.slug}`}>{heading.text}</a>
          {subs.length > 0 && (
            <ol>
              {subs.map((s) => (
                <li>
                  <a href={`#${s.slug}`}>{s.text}</a>
                </li>
              ))}
            </ol>
          )}
        </li>
      ))}
    </ol>
  </details>
) : (
  <nav class="toc" aria-labelledby="toc-label" data-toc data-toc-rail>
    <p class="toc__label" id="toc-label">
      on this page
    </p>
    <ol>
      {items.map(({ heading, subs }) => (
        <li>
          <a href={`#${heading.slug}`}>{heading.text}</a>
          {subs.length > 0 && (
            <ol class="toc__sub">
              {subs.map((s) => (
                <li>
                  <a href={`#${s.slug}`}>{s.text}</a>
                </li>
              ))}
            </ol>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  /* A long list scrolls inside itself, stopping above "back to top" in the corner, so its last
     sections never sit below the screen. The gutter keeps the links' focus rings unclipped. */
  .toc {
    position: sticky;
    top: 112px;
    align-self: start;
    max-height: calc(100vh - 112px - var(--target) - 2 * (var(--space-16) + var(--space-10)));
    margin: 0 calc(-1 * var(--space-6));
    padding: 0 var(--space-6) var(--space-6);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    font-size: 14px;
    line-height: 1.45;
  }
  .toc__label {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 12px;
    color: var(--muted);
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc > ol {
    border-left: 1px solid var(--line);
  }
  .toc a {
    display: block;
    margin-left: -1px;
    padding: 6px 0 6px 16px;
    border-left: 1.5px solid transparent;
    color: var(--muted);
    text-decoration: none;
    transition:
      color var(--duration-hover) var(--ease-standard),
      border-color var(--duration-hover) var(--ease-standard);
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc a[aria-current='true'] {
    color: var(--text);
    border-left-color: var(--accent);
  }
  .toc .toc__sub a {
    padding-left: 30px;
    font-size: 13px;
  }
  /* The script's rail (src/scripts/toc.ts): one line that steps in beside each group of h3s, and a
     marker that slides along it. It replaces the straight border and the links' own. */
  .toc--rail > ol,
  .toc--rail a,
  .toc--rail a[aria-current='true'] {
    border-left-color: transparent;
  }
  .toc :global(.toc__rail) {
    position: absolute;
    top: 0;
    left: 0;
    overflow: visible;
    pointer-events: none;
  }
  .toc :global(.toc__track),
  .toc :global(.toc__marker) {
    fill: none;
    stroke-linejoin: round;
  }
  .toc :global(.toc__track) {
    stroke: var(--line);
    stroke-width: 1px;
  }
  .toc :global(.toc__marker) {
    stroke: var(--accent);
    stroke-width: 1.5px;
  }
  .toc--ready :global(.toc__marker) {
    transition:
      stroke-dasharray var(--duration-move) var(--ease-move),
      stroke-dashoffset var(--duration-move) var(--ease-move);
  }

  /* Each form shows at its own width: the column on desktop, the panel on phones. */
  .toc-phone {
    display: none;
    margin-bottom: var(--space-28);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .toc-phone summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 48px;
    padding: 0 16px;
    list-style: none;
    font-size: 15px;
    cursor: pointer;
  }
  .toc-phone summary::-webkit-details-marker {
    display: none;
  }
  .toc-phone[open] summary svg {
    transform: rotate(180deg);
  }
  .toc-phone ol {
    margin: 0;
    padding: 4px 16px 14px 36px;
    font-size: 15px;
    line-height: 1.5;
  }
  .toc-phone ol ol {
    padding: 0 0 0 20px;
    font-size: 14px;
  }
  /* Plain links, as in the mockups. Each fills its row (the mockups' 8px gap becomes padding), so
     the whole line is the tap target. */
  .toc-phone a {
    display: block;
    padding: 4px 0;
    color: var(--text);
    text-decoration: none;
    transition: color var(--duration-hover) var(--ease-standard);
  }
  .toc-phone a:hover {
    color: var(--link);
  }
  .toc-phone ol ol a {
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .toc a,
    .toc-phone a,
    .toc--ready :global(.toc__marker) {
      transition: none;
    }
  }
  @media (max-width: 760px) {
    .toc {
      display: none;
    }
    .toc-phone {
      display: block;
    }
  }
</style>

<script>
  import { bindToc } from '../../scripts/toc';
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach(bindToc);
</script>
