---
// The path mark: a lowercase h drawn as one line, ending in a brick dot.
// Stroke and dot thicken as the mark gets smaller (see docs/brand.md).
import { MARK_PATH, markWeight } from '../lib/logo';

interface Props {
  /** Its width and height in px; the stroke and dot weight follow from it (src/lib/logo.ts). */
  size?: number;
  /** Accessible name when the mark stands alone; omit when the name is set beside it. */
  label?: string;
  /**
   * Play the draw on load (`true`) or when the mark comes into view (`'view'`), and again on hover
   * of the closest `[data-logo-draw]` element.
   */
  draw?: boolean | 'view';
  /** The dot squashes and bounces at the foot of the leg (loading, and the 404). Still under reduced motion. */
  loading?: boolean;
  /** An extra class, for placing the mark in a layout. */
  class?: string;
}

const { size = 26, label, draw = false, loading = false, class: className } = Astro.props;

const { stroke, dot } = markWeight(size);
---

<svg
  class:list={['mark', { 'mark--loading': loading }, className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-mark-draw={draw === 'view' ? 'view' : draw ? 'load' : undefined}
>
  <path class="mark__h" d={MARK_PATH} stroke-width={stroke}></path>
  <circle class="mark__dot" cx="70" cy="88" r={dot}></circle>
</svg>

<style>
  .mark {
    flex: none;
    overflow: visible;
  }
  .mark__h {
    fill: none;
    stroke: var(--text);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mark__dot {
    fill: var(--accent);
  }
  /* The mark lets its contents overflow, so the lowest point of the bounce is never clipped. */
  .mark--loading .mark__dot {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: bounce 1s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes bounce {
    0%,
    100% {
      transform: translateY(-4px) scale(0.94, 1.06);
    }
    48% {
      transform: translateY(10px) scale(1);
    }
    56% {
      transform: translateY(12px) scale(1.22, 0.74);
    }
    64% {
      transform: translateY(10px) scale(0.96, 1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mark--loading .mark__dot {
      animation: none;
    }
  }
</style>

<script>
  import { bindDraw } from '../scripts/logo-draw';
  document
    .querySelectorAll<SVGSVGElement>('svg[data-mark-draw]')
    .forEach((svg) => bindDraw(svg, svg.dataset['markDraw'] === 'view' ? 'view' : 'load'));
</script>
