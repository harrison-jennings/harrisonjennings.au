---
// The path mark: a lowercase h drawn as one line, ending in a brick dot.
// Stroke and dot thicken as the mark gets smaller (see docs/brand.md).
interface Props {
  size?: number;
  /** Accessible name when the mark stands alone; omit when the name is set beside it. */
  label?: string;
  /**
   * Play the draw on load (`true`) or when the mark comes into view (`'view'`), and again on hover
   * of the closest `[data-logo-draw]` element.
   */
  draw?: boolean | 'view';
  class?: string;
}

const { size = 26, label, draw = false, class: className } = Astro.props;

const weights: Array<[number, number, number]> = [
  [40, 11, 7.5],
  [26, 12, 8.5],
  [24, 15, 9.5],
  [0, 17, 10.5],
];
const [, stroke, dot] = weights.find(([min]) => size >= min) ?? [0, 17, 10.5];
const H = 'M30 10 V90 M30 58 C30 44 39 38 50 38 C61 38 70 44 70 58 V72';
---

<svg
  class:list={['mark', className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-mark-draw={draw === 'view' ? 'view' : draw ? 'load' : undefined}
>
  <path class="mark__h" d={H} stroke-width={stroke}></path>
  <circle class="mark__dot" cx="70" cy="88" r={dot}></circle>
</svg>

<style>
  .mark {
    flex: none;
    overflow: visible;
  }
  .mark__h {
    fill: none;
    stroke: var(--text);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mark__dot {
    fill: var(--accent);
  }
</style>

<script>
  import { bindDraw } from '../scripts/logo-draw';
  document
    .querySelectorAll<SVGSVGElement>('svg[data-mark-draw]')
    .forEach((svg) => bindDraw(svg, svg.dataset['markDraw'] === 'view' ? 'view' : 'load'));
</script>
