---
// A post on a card (PostCardView): date, title, its description and its main topic as a tag (a link
// once the topic has its own page, a dashed label until then).
import { getEntry, type CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/dates';
import { mainTopic, postPath, topicPath } from '../lib/posts';
import PostCardView from './PostCardView.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  /** Ids of the topics that have their own page. */
  topicPages: ReadonlySet<string>;
}

const { post, topicPages } = Astro.props;
const { title, description, published } = post.data;
const topicRef = mainTopic(post);
const topic = topicRef ? await getEntry(topicRef) : undefined;
const tag = topic && {
  name: topic.data.name,
  href: topicPages.has(topic.id) ? topicPath(topic) : undefined,
};
---

<PostCardView href={postPath(post)} datetime={isoDate(published)} tag={tag}>
  <Fragment slot="date">{formatDate(published)}</Fragment>
  <Fragment slot="title">{title}</Fragment>
  {description}
</PostCardView>
