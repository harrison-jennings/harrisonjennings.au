---
// "live at {host}" after the live dot. The words carry the meaning.
import LiveDot from './LiveDot.astro';

interface Props {
  host: string;
  /** The live URL: the host becomes a link, underlined like a text link. */
  href?: string | undefined;
}

const { host, href } = Astro.props;
---

{href ? (
  <a class="live" href={href}>
    <LiveDot />
    live at <span class="live__host">{host}</span>
  </a>
) : (
  <span class="live">
    <LiveDot />
    live at {host}
  </span>
)}

<style>
  .live {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
  }
  .live__host {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }
  a.live:hover .live__host {
    color: var(--link);
    text-decoration-color: var(--link);
    text-decoration-thickness: 2px;
  }
</style>
