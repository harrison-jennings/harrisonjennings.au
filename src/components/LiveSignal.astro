---
// The live dot: a brick point with a halo that pulses. The words carry the meaning.
interface Props {
  host: string;
  /** The live URL: the host becomes a link, underlined like a text link. */
  href?: string | undefined;
}

const { host, href } = Astro.props;
---

{href ? (
  <a class="live" href={href}>
    <span class="live__dot" aria-hidden="true"></span>live at <span class="live__host">{host}</span>
  </a>
) : (
  <span class="live">
    <span class="live__dot" aria-hidden="true"></span>live at {host}
  </span>
)}

<style>
  .live {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
  }
  .live__host {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }
  a.live:hover .live__host {
    color: var(--link);
    text-decoration-color: var(--link);
    text-decoration-thickness: 2px;
  }
  .live__dot {
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    box-shadow: var(--shadow-signal);
  }
  .live__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1.5px solid var(--accent);
    animation: pulse 1.8s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
</style>
