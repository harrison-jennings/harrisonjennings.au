---
// The live dot: a brick point with a halo that pulses. Archived: a hollow ring that stays still.
interface Props {
  archived?: boolean;
}

const { archived = false } = Astro.props;
---

<span class:list={['dot', { 'dot--archived': archived }]} aria-hidden="true"></span>

<style>
  .dot {
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    box-shadow: var(--shadow-signal);
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1.5px solid var(--accent);
    animation: pulse 1.8s ease-out infinite;
  }
  .dot--archived {
    box-sizing: border-box;
    background: transparent;
    border: 1.5px solid var(--muted);
    box-shadow: none;
  }
  .dot--archived::after {
    display: none;
  }
  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
</style>
