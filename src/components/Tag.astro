---
// Outlined topic chip: a link when it points at a topic page. A topic without a page (fewer than
// two posts) is a `label`: dashed outline, muted text, not a link.
interface Props {
  href?: string;
  label?: boolean;
}

const { href, label = false } = Astro.props;
---

{href && !label ? (
  <a class="tag" href={href}>
    <slot />
  </a>
) : (
  <span class:list={['tag', { 'tag--label': label }]}>
    <slot />
  </span>
)}

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 12px;
    line-height: 1.2;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }
  a.tag:hover {
    border-color: var(--link);
    color: var(--link);
  }
  .tag--label {
    border-style: dashed;
    color: var(--muted);
  }
</style>
