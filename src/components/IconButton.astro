---
// Icon-only link for the two platforms: text at rest, link on hover and focus. 44px target;
// `large` is the 48px plain version for the mobile menu.
import { NEW_TAB_NOTE } from '../lib/links';
import Icon from './Icon.astro';

interface Props {
  /** The profile's address. It opens in a new tab. */
  href: string;
  /** The link's name for screen readers, as the icon has none: "GitHub profile". */
  label: string;
  /** Which platform: only these two. */
  icon: 'github' | 'linkedin';
  /** The 48px plain version, for the phone menu. */
  large?: boolean;
}

const { href, label, icon, large = false } = Astro.props;
const size = icon === 'github' ? (large ? 22 : 20) : large ? 21 : 19;
---

<a
  class:list={['icon-btn', { 'icon-btn--lg': large }]}
  href={href}
  aria-label={`${label}${NEW_TAB_NOTE}`}
  rel="me noopener"
  target="_blank"
>
  <Icon name={icon} size={size} />
</a>

<style>
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--target);
    height: var(--target);
    border-radius: var(--radius-pill);
    color: var(--text);
    text-decoration: none;
    transition: color var(--duration-hover) var(--ease-standard);
  }
  .icon-btn:hover,
  .icon-btn:focus-visible {
    color: var(--link);
  }
  .icon-btn--lg {
    width: var(--target-touch);
    height: var(--target-touch);
  }
</style>
