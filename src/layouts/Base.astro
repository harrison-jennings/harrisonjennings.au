---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { SITE } from '../consts';
import { feedPath } from '../lib/feed';
import { WIDTH, HEIGHT } from '../lib/og/card';
import { shareImageFor } from '../lib/og/cards';

interface Props {
  title?: string;
  description?: string;
  /** Keep a page out of search results (drafts, previews, utility pages). */
  noindex?: boolean;
  /** The nav floats over the page's first screen (the home hero, the 404) instead of sitting above it. */
  float?: boolean;
  /** Feeds besides the whole blog's, such as a topic page's own. */
  feeds?: Array<{ title: string; href: string }>;
  /** Replaces the page's share card, such as a post's own `socialImage`. */
  image?: { src: string; width: number; height: number } | undefined;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  float = false,
  feeds = [],
  image,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The share card: the page's own (generated at build), or the home card.
const share = image ?? {
  src: await shareImageFor(Astro.url.pathname),
  width: WIDTH,
  height: HEIGHT,
};
const shareUrl = new URL(share.src, Astro.site);
---

<!doctype html>
<html lang={SITE.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121110" />
    <!-- Dark on every first visit; a saved choice (the nav's theme toggle) applies before first paint. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('hj-theme');
        document.documentElement.setAttribute('data-theme', saved === 'light' ? 'light' : 'dark');
        if (saved === 'light')
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f4efeb');
      } catch {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {[{ title: SITE.name, href: feedPath() }, ...feeds].map((feed) => (
      <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
    ))}

    <link
      rel="preload"
      href="/fonts/SchibstedGrotesk-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/MartianMono-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      skip to content
    </a>
    <Nav float={float} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
