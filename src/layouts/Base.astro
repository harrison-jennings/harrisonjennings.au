---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import Consent from '../components/Consent.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { SITE } from '../consts';
import { feedPath } from '../lib/feed';
import { WIDTH, HEIGHT } from '../lib/og/card';
import { CONSENT_COOKIE } from '../lib/consent';
import { shareImageFor } from '../lib/og/cards';
import { tagManagerEnvironment, tagManagerSrc } from '../lib/tag-manager';

interface Props {
  title?: string;
  description?: string;
  /** Keep a page out of search results (drafts, previews, utility pages). */
  noindex?: boolean;
  /** The nav floats over the page's first screen (the home hero, the 404) instead of sitting above it. */
  float?: boolean;
  /** Feeds besides the whole blog's, such as a topic page's own. */
  feeds?: Array<{ title: string; href: string }>;
  /** Replaces the page's share card, such as a post's own `socialImage`. */
  image?: { src: string; width: number; height: number } | undefined;
  /** What the page tells Tag Manager about itself (the data layer keys the WordPress site used). */
  dataLayer?: { page_type?: string; categories?: string; post_id?: string } | undefined;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  float = false,
  feeds = [],
  image,
  dataLayer = {},
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The share card: the page's own (generated at build), or the home card.
const share = image ?? {
  src: await shareImageFor(Astro.url.pathname),
  width: WIDTH,
  height: HEIGHT,
};
const shareUrl = new URL(share.src, Astro.site);

// Google Consent Mode (advanced): everything optional is denied until the visitor chooses. A returning
// visitor's saved choice (CookieConsent's cookie, same revision) is applied here too, before Tag
// Manager loads, so their first page view isn't sent as if they'd refused. Then the page's data layer
// keys, then Tag Manager itself (Live on production, Testing on previews, nothing locally).
//
// The script is the same on every page, so the Content-Security-Policy allows it by one hash
// (src/lib/csp-build.ts). The page's own keys come from the JSON just before it, which never runs.
const consent = await getEntry('consent', 'consent');
if (!consent) throw new Error('src/content/consent.yaml: missing the `consent` entry');
const consentHead = `window.dataLayer = window.dataLayer || [];
function gtag() { dataLayer.push(arguments); }
gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', personalization_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted', wait_for_update: 500 });
gtag('set', 'ads_data_redaction', true);
try {
  const saved = document.cookie.match(/(?:^|;\\s*)${CONSENT_COOKIE}=([^;]+)/);
  const choice = saved && JSON.parse(decodeURIComponent(saved[1]));
  if (choice && choice.revision === ${consent.data.revision} && Array.isArray(choice.categories)) {
    const analytics = choice.categories.includes('analytics') ? 'granted' : 'denied';
    const ads = choice.categories.includes('advertising') ? 'granted' : 'denied';
    gtag('consent', 'update', { analytics_storage: analytics, ad_storage: ads, ad_user_data: ads, ad_personalization: ads });
  }
} catch {}
dataLayer.push(JSON.parse(document.querySelector('script[data-page-layer]').textContent));`;
// `<` escaped, so a title can never close the script element early.
const pageLayer = JSON.stringify({
  page_name: pageTitle,
  page_type: dataLayer.page_type ?? 'page',
  post_author: 'Harrison Jennings',
  categories: dataLayer.categories ?? '',
  tags: '',
  post_id: dataLayer.post_id ?? '',
}).replaceAll('<', '\\u003c');
const tagManager = tagManagerEnvironment();
const tagManagerHead =
  tagManager &&
  `(function (w, d, s, l) { w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' }); const f = d.getElementsByTagName(s)[0]; const j = d.createElement(s); j.async = true; j.src = ${JSON.stringify(tagManagerSrc(tagManager))}; f.parentNode.insertBefore(j, f); })(window, document, 'script', 'dataLayer');`;
---

<!doctype html>
<html lang={SITE.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121110" />
    <!-- Dark on every first visit; a saved choice (the nav's theme toggle) applies before first paint. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('hj-theme');
        document.documentElement.setAttribute('data-theme', saved === 'light' ? 'light' : 'dark');
        if (saved === 'light')
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f4efeb');
      } catch {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
    <script is:inline type="application/json" data-page-layer set:html={pageLayer} />
    <script is:inline set:html={consentHead} />
    {tagManagerHead && <script is:inline set:html={tagManagerHead} />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {[{ title: SITE.name, href: feedPath() }, ...feeds].map((feed) => (
      <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
    ))}

    <link
      rel="preload"
      href="/fonts/SchibstedGrotesk-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/MartianMono-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      skip to content
    </a>
    <Consent />
    <Nav float={float} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
