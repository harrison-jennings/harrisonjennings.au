---
// Home: the hero, then what I do, built and shipped, still shipping (the GitHub contributions graph),
// what people are saying, latest posts and the booking band. All wording lives in src/content/
// (home.yaml, services.yaml, testimonials.yaml, projects.yaml and the posts); the graph's numbers come
// from GitHub at build time (src/lib/contributions.ts).
import Booking from '../components/home/Booking.astro';
import BuiltAndShipped from '../components/home/BuiltAndShipped.astro';
import Contributions from '../components/home/Contributions.astro';
import Hero from '../components/home/Hero.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import Services from '../components/home/Services.astro';
import Testimonials from '../components/home/Testimonials.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { business } from '../lib/structured-data';

const services = (await getCollection('services')).map((s) => s.data);
---

<Base float structuredData={[business(services)]}>
  <Hero />
  <div class="sections">
    <Services />
    <BuiltAndShipped />
    <Contributions />
    <Testimonials />
    <LatestPosts />
    <Booking />
  </div>
</Base>

<style>
  .sections {
    padding-top: 96px;
  }
  @media (max-width: 760px) {
    .sections {
      padding-top: var(--space-72);
    }
  }
</style>
