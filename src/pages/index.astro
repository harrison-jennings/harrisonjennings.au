---
// Home: the hero, then what I do, built and shipped, what people are saying, latest posts and the
// booking band. All wording lives in src/content/ (home.yaml, services.yaml, testimonials.yaml,
// projects.yaml and the posts).
import Booking from '../components/home/Booking.astro';
import BuiltAndShipped from '../components/home/BuiltAndShipped.astro';
import Hero from '../components/home/Hero.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import Services from '../components/home/Services.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Base from '../layouts/Base.astro';
---

<Base noindex float>
  <Hero />
  <div class="sections">
    <Services />
    <BuiltAndShipped />
    <Testimonials />
    <LatestPosts />
    <Booking />
  </div>
</Base>

<style>
  .sections {
    padding-top: 96px;
  }
  @media (max-width: 760px) {
    .sections {
      padding-top: var(--space-72);
    }
  }
</style>
